# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# DynamoDB Tables
CLIENTS_TABLE=real-estate-crm-clients-dev
INTERACTIONS_TABLE=real-estate-crm-interactions-dev
SCHEDULED_MESSAGES_TABLE=real-estate-crm-scheduled-messages-dev

# Application URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=https://your-api-gateway-url.amazonaws.com/dev

# Email Configuration (SES)
FROM_EMAIL=noreply@yourdomain.com
COMPANY_NAME=Your Real Estate Company

# Development Settings
NODE_ENV=development
IS_OFFLINE=true

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
